[Unit]
Description=One English API
After=network.target postgresql.service redis-server.service

[Service]
User=oneenglish
Group=oneenglish
WorkingDirectory=/opt/one-english/backend
EnvironmentFile=/etc/one-english/env
ExecStart=/opt/one-english/venv/bin/uvicorn app.main:app --host 127.0.0.1 --port ${OE_PORT} --workers 2 --proxy-headers --forwarded-allow-ips=127.0.0.1
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/one-english

[Install]
WantedBy=multi-user.target
