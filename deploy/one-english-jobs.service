[Unit]
Description=One English background jobs
After=network.target postgresql.service redis-server.service

[Service]
User=oneenglish
Group=oneenglish
WorkingDirectory=/opt/one-english/backend
EnvironmentFile=/etc/one-english/env
ExecStart=/opt/one-english/venv/bin/python -m app.jobs loop
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/one-english

[Install]
WantedBy=multi-user.target
